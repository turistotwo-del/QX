{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "web",
    "noEmitOnError": true,
    "removeComments": false
